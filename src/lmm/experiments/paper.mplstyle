# Shared matplotlib style for all Phase 7 figures (lmm.experiments.plotting
# applies it). Colorblind-safe Okabe-Ito prop_cycle; vector-friendly defaults.
# Every figure is saved as both PDF (for LaTeX) and PNG.

figure.figsize: 7.0, 4.2
figure.dpi: 110
savefig.dpi: 200
savefig.bbox: tight
savefig.pad_inches: 0.05

font.size: 10
axes.titlesize: 11
axes.labelsize: 10
legend.fontsize: 9
xtick.labelsize: 9
ytick.labelsize: 9

axes.grid: True
grid.alpha: 0.3
grid.linewidth: 0.6
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False

lines.linewidth: 1.6
lines.markersize: 4

legend.frameon: False

# Okabe-Ito colorblind-safe cycle (blue, orange, green, vermillion, sky,
# purple, yellow, grey).
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', '56B4E9', 'CC79A7', 'F0E442', '999999'])

# Keep PDF/PS text as editable text (TrueType), not paths.
pdf.fonttype: 42
ps.fonttype: 42
